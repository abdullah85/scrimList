{
  "name": "ScrimList",
  "version": "0.1.0.0",
  "description": "ScrimList numbers each topic in a path or course in scrimba.",
  "manifest_version": 3,
  "action": {
    "default_title": "ScrimList",
    "default_icon": {
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "64": "icons/icon_64.png",
      "128": "icons/icon_128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": ["storage"],
  "icons": {
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "64": "icons/icon_64.png",
    "128": "icons/icon_128.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/content_for_scrim.js"
      ],
      "matches": [
	      "https://scrimba.com/*"
      ]
    }
  ]
}
